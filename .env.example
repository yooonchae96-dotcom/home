# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > SDK 설정에서 복사해 넣으세요.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 관리자(선생님) 구글 이메일. 여러 명이면 쉼표로 구분
VITE_ADMIN_EMAILS=

# 파일 모음: 하루에 올릴 수 있는 총 용량(GB). 비우면 5
VITE_DAILY_UPLOAD_GB=5

# 나이스 학사일정 API (선택). 비워 두고 앱 안의 'API 변경' 버튼으로 넣어도 됩니다.
VITE_NEIS_KEY=
VITE_NEIS_ATPT=
VITE_NEIS_SCHUL=
VITE_SCHOOL_NAME=
